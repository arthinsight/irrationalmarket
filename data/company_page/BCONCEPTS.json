6170],["2026-08-17",157.11,18508],["2026-08-18",159.8,7503],["2026-08-19",159.7,8177],["2026-08-20",155.29,16041],["2026-08-21",161.96,17006],["2026-08-24",160.3,16144],["2026-08-25",159.63,20773],["2026-08-26",160.48,2765],["2026-08-27",160.01,20738],["2026-08-28",163.07,9226],["2026-08-31",164.67,16369],["2026-09-01",162.75,10683],["2026-09-02",165.27,7512]],"topics":{"business_model":{"title":"Positioning (investor deck)","body":"- Exclusive licensee for six premium international brands (Tommy Hilfiger, United Colors of Benetton, Juicy Couture, Superdry, Off-White, Aeropostale) plus in-house brands Sugarush and The Vertical/Bagline, having moved from a 'brand distributor / bought-out sourced' trading model to a vertically integrated multi-brand lifestyle platform across travel gear, handbags, small leather goods and lifestyle accessories.\n- Tommy Hilfiger products are positioned as trendy/aspirational yet priced 10-25% below some peers despite a more exclusive brand perception, a value-plus-premium positioning versus a 'monotonous premium travel segment'.\n- Opened India's first Off-White store (Bengaluru), staking out first-mover ground in the 'luxury streetwear' category domestically.","src":"deck","as_of":"14-08-2026"},"segment_detail":{"title":"Segment / subsidiary detail","body":"Apparel and accessories manufacturing","src":"concall","as_of":"FY26"},"order_book":{"title":"Order book & pipeline","body":"Not disclosed","src":"concall","as_of":"FY26"},"guidance":{"title":"Guidance / outlook","body":"Stable outlook; focus on sustainable fashion and e-commerce expansion","src":"concall","as_of":"FY26"},"growth_optionality":{"title":"Growth verticals / optionality","body":"Expansion into new markets; increasing online presence","src":"concall","as_of":"FY26"},"margins":{"title":"Margins & cost dynamics","body":"Not disclosed","src":"concall","as_of":"FY26"},"capital_allocation":{"title":"Capital allocation","body":"Debt financing through bank loan facilities","src":"concall","as_of":"FY26"},"management_tone":{"title":"Management quality / tone","body":"n/a (non-concall source)","src":"concall","as_of":"FY26"},"risks":{"title":"Risks & watch-items","body":"Regulatory changes; market competition","src":"concall","as_of":"FY26"},"non_obvious":{"title":"Non-obvious takeaways","body":"The company's focus on sustainable fashion could provide a competitive edge in the market.","src":"concall","as_of":"FY26"},"challenges":{"title":"Challenges → beneficiaries & losers","body":"| — | — | — | — |","src":"concall","as_of":"FY26"},"other":{"title":"Notable from the deck","body":"- [Manufacturing tie-up] Consolidation with IFF overseas is bringing soft-luggage manufacturing expertise into Brand Concepts' fold, complementing its existing in-house hard-luggage manufacturing.\n- [External risk] Deck flags two structural headwinds: 'Modern Trade Intensification' from well-funded new-age players bidding up rentals while splitting sales across more competitors, and a materially 'Strengthening USD' raising the cost of imported raw materials.\n- [License terms] Tommy Hilfiger exclusive license runs through Dec 2026; United Colors of Benetton exclusive license runs through 2030; Juicy Couture, Superdry and Off-White are held under long-term contracts/distribution agreements.","src":"deck","as_of":"14-08-2026"}}}