t_tone":{"title":"Management quality / tone","body":"Confident and strategic; focused on volume over revenue due to gold price distortion; clear shift from inventory-led to bulk-order-led model; strong emphasis on design ecosystem and client-specific teams; cautious on FY27 guidance but optimistic on structural growth","src":"concall","as_of":"Q2FY26"},"risks":{"title":"Risks & watch-items","body":"Gold price volatility (mitigated by 100% hedging); Over-reliance on retail chain demand; Slow adoption of lower carat jewellery; Aneya brand scaling risk; Competition from casting-focused players with higher volume turnover","src":"concall","as_of":"Q2FY26"},"non_obvious":{"title":"Non-obvious takeaways","body":"The company is transitioning from a traditional gold jeweller to a B2B design-and-manufacture partner for national chains — clients now supply gold for bulk orders, reducing Ashapuri’s working capital burden and shifting risk to retailers","src":"concall","as_of":"Q2FY26"},"challenges":{"title":"Challenges → beneficiaries & losers","body":"| Challenge | Beneficiary/Loser | Dir | Conviction | Note |\n|---|---|---|---|---|\n| Gold price surge erodes volume growth visibility | Ashapuri Gold Ornament Limited | beneficiary | High | 100% gold hedging and bulk-order model insulate margins and working capital, turning price volatility into a structural advantage |","src":"concall","as_of":"Q2FY26"}}}