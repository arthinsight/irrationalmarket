026-08-10",20.0,14000],["2026-08-11",19.25,6000],["2026-08-13",20.1,14000],["2026-08-14",19.1,16000],["2026-08-18",18.42,10000],["2026-08-19",17.69,8000],["2026-08-20",17.05,24000],["2026-08-21",16.81,20000],["2026-08-24",17.65,30000],["2026-08-25",18.53,26000],["2026-08-26",18.45,6000],["2026-08-27",19.12,26000]],"topics":{"segment_detail":{"title":"Segment / subsidiary detail","body":"Govt/PSU mix currently 85% (60% State, 40% PSUs), targeting shift to 30% State / 40% PSU / 30% Enterprise over 2-3 years to improve cash cycles. New focus on BFSI sector in Mumbai and North East.","src":"concall","as_of":"Q4FY26"},"order_book":{"title":"Order book & pipeline","body":"Rs. 32 Cr confirmed (Rs. 12 Cr services/O&M, Rs. 20 Cr supply & installation). Rs. 20-22 Cr expected to bill in H1FY27. Prices for fixed-price portion locked with OEMs.","src":"concall","as_of":"Q4FY26"},"guidance":{"title":"Guidance","body":"Revenue Growth: 15-20% YoY (surpassing FY25 levels); Margin: 11-13% EBITDA for FY27; Order Inflow: Pipeline growing 15-20% over current book; Capex: Minimal, focus on working capital and vendor pre-payments.","src":"concall","as_of":"Q4FY26"},"growth_optionality":{"title":"Growth verticals / optionality","body":"DPDP Act compliance projects creating new inquiry pipeline; Geographic expansion into Mumbai (BFSI) and Seven Sister States; Shift to 'Make in India' procurement to bypass global supply shocks.","src":"concall","as_of":"Q4FY26"},"margins":{"title":"Margins & cost dynamics","body":"H2 margins compressed to 5.32% due to component inflation (30-300%) and supply delays (6 weeks to 12 months). New contracts include price escalation clauses; existing book protected via pre-booked OEM pricing.","src":"concall","as_of":"Q4FY26"},"capital_allocation":{"title":"Capital allocation","body":"Priority given to debt reduction (40% cut) and trade payable clearance (Rs. 30.2 Cr to Rs. 3.77 Cr) to strengthen balance sheet before pursuing growth.","src":"concall","as_of":"Q4FY26"},"management_tone":{"title":"Management quality / tone","body":"Prudent, transparent, and disciplined. Emphasized 'financial discipline' over 'chasing revenue' during crisis. Confident on FY27 recovery based on visible pipeline.","src":"concall","as_of":"Q4FY26"},"risks":{"title":"Risks & watch-items","body":"Persistence of global supply chain turbulence beyond 3-4 months; High dependency on government payment cycles; Execution risk in scaling enterprise/BFSI verticals.","src":"concall","as_of":"Q4FY26"},"non_obvious":{"title":"Non-obvious takeaways","body":"Management deliberately canceled/deferred contracts rather than execute at a loss, a rare move that preserved liquidity while peers (e.g., Allied Digital) reported losses. A Rs. 5 Cr order was voluntarily returned to re-bid under better terms.","src":"concall","as_of":"Q4FY26"},"challenges":{"title":"Challenges → beneficiaries & losers","body":"| Challenge | Beneficiary/Loser | Dir | Conviction | Note |\n|---|---|---|---|---|\n| Global supply chain normalization and shift to domestic sourcing | Tejas Networks | beneficiary | Med | As a domestic manufacturer, Tejas may gain share if integrators like Takyon aggressively pivot to 'Make in India' hardware to avoid import lead times. |\n| Increased demand for data privacy compliance infrastructure | Tata Elxsi | beneficiary | Low | DPDP Act driving inquiries could benefit specialized compliance consultants, though Takyon aims to capture the integration layer itself. |","src":"concall","as_of":"Q4FY26"}}}