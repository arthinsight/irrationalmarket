ness contributed approximately 33.38% of total revenue, with products reaching more than 35 countries across five continents|Approximately three-fourths …","objects":null,"oem":"","one_liner":"Oriental Aromatics Limited is a fully integrated Indian manufacturer of fragrances, flavours, specialty aroma ingredients and camphor & terpene chemicals, operating across the entire value chain from molecule synthesis to global customer delivery.","peer_panel":{"asof":"2026-08-14","industry":"Chemicals & Petrochemicals","peers":[{"ebitda_margin":10.2,"fy":"FY26","growth_basis":"7y CAGR","mcap":1860,"name":"S H KELKAR AND CO. LTD.","pat":69.2,"pat_growth":-3.5,"pe":26.9,"rev":2368.3,"rev_growth":12.4,"s":"SHK","source":"product","why":"shares aroma/compounds/fragrance/fragrances"},{"ebitda_margin":24.1,"fy":"FY26","growth_basis":"7y CAGR","mcap":145927,"name":"PIDILITE INDUSTRIES LTD","pat":2470.7,"pat_growth":15.1,"pe":59.1,"rev":14600.8,"rev_growth":10.9,"s":"PIDILITIND","source":"industry","why":"same industry (Chemicals & Petrochemicals)"},{"ebitda_margin":26.6,"fy":"FY26","growth_basis":"7y CAGR","mcap":137111,"name":"SOLAR INDUSTRIES (I) LTD","pat":1736.6,"pat_growth":31.0,"pe":79.0,"rev":9837.7,"rev_growth":21.9,"s":"SOLARINDS","source":"industry","why":"same industry (Chemicals & Petrochemicals)"},{"ebitda_margin":21.6,"fy":"FY26","growth_basis":"7y CAGR","mcap":77743,"name":"SRF LTD","pat":1835.2,"pat_growth":16.2,"pe":42.4,"rev":15786.5,"rev_growth":12.1,"s":"SRF","source":"industry","why":"same industry (Chemicals & Petrochemicals)"},{"ebitda_margin":35.9,"fy":"FY26","growth_basis":"7y CAGR","mcap":57861,"name":"LINDE INDIA LIMITED","pat":550.9,"pat_growth":-3.9,"pe":105.0,"rev":2530.6,"rev_growth":5.3,"s":"LINDEINDIA","source":"industry","why":"same industry (Chemicals & Petrochemicals)"},{"ebitda_margin":25.8,"fy":"FY26","growth_basis":"7y CAGR","mcap":35662,"name":"GUJARAT FLUOROCHEM LTD","pat":574.0,"pat_growth":-10.5,"pe":62.1,"rev":4996.0,"rev_growth":9.0,"s":