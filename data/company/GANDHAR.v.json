18",255.1,2220605],["2026-08-19",250.15,959345]],"stock":{"a":4.1,"ad":"2026-08-19","atd":"2025-01-01","c":"agg accumulation","cl":250.15,"d":23,"fam":"2024-10","ft":"2025-01-01","g":2,"iid":"15539","ins":{"cd":"2026-06-02","cluster":"Oil & Gas","co":"GANDHAR OIL REFINERY (INDIA) LTD","has":true,"layer":"Specialty oil refiner / formulator","q":"Q4FY26","sec":"Specialty Petroleum — White Oils / Petrochem","st":[{"status":"Runner-up","subtheme":"Oil & Gas - gas economy (CGD/LNG) + refining/upstream","tag":"Oil-Gas","theme":"Energy (Oil & Gas)","tier":"2"}],"thesis":"This is a **war-margin quarter, and management barely pretends otherwise**: revenue +92% YoY to ₹1,732cr, EBITDA +512% to ₹281cr (16.2% vs 5.1%), PAT ₹206cr — **more than the whole of FY26** — driven by a gross spread of **₹28,145/KL versus ~₹8,274/KL in a normal environment**. Volume grew only **8%** (131k KL); essentially all of the delta is realisation. The Hormuz closure constrained base-oil supply, Gandhar re-sourced from South Korea and domestic producers, and sold availability at a premium. Management guides these spreads to hold \"for the whole year\" while simultaneously calling the quarter exceptional — that contradiction is the entire investment question.","trig":[]},"lm":"2026-08","m":2448,"mem":0,"pdd":"","prev_stage":4,"prev_zone_vpe":null,"r":16.8,"s":"GANDHAR","sig":"Advancing (S2)","sx":{"SMA_50":"209.7","base_count":"","drawdown_from_prev_signal":"","duration_from_prev_signal":"","pct_below_52w_high":"17.0","pct_change_from_prev_signal":"","pivot_close":"","pivot_low":"","stage_changed_since_prev_signal":"","vpe_df_60d_sum":"0.3","vpe_zone_cumul_df":"0.5"},"t":""}},"s":"GANDHAR"}