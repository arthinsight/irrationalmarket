erred revenue actually recognizes in Q1-Q2 FY27**.","trig":[]},"lm":"2025-06","m":6607,"mem":0,"pdd":"2025-03-21","prev_stage":2,"prev_zone_vpe":null,"r":123.3,"s":"AXISCADES","sig":"","sx":{"SMA_50":"1664.0","base_count":"","drawdown_from_prev_signal":"","duration_from_prev_signal":"","pct_below_52w_high":"30.0","pct_change_from_prev_signal":"","pivot_close":"","pivot_low":"","stage_changed_since_prev_signal":"","vpe_df_60d_sum":"-1.9","vpe_zone_cumul_df":"-0.2"},"t":""}},"s":"AXISCADES"}