4.53],["2026-06-22",47.99],["2026-06-23",47.34],["2026-06-24",49.93],["2026-06-25",49.18],["2026-06-29",46.64],["2026-06-30",48.71],["2026-07-01",47.5],["2026-07-02",48.21],["2026-07-03",47.86],["2026-07-06",48.05],["2026-07-07",46.55],["2026-07-08",45.41],["2026-07-09",46.04],["2026-07-10",46.56]],"qtr":"FY26","ratios":[{"label":"ROE %","value":"7.9%"},{"label":"ROCE %","value":"7.5%"},{"label":"D/E","value":"0.1x"},{"label":"Int cover","value":"8.8x"},{"label":"Receivable d","value":"6.1"},{"label":"Inventory d","value":"16.0"},{"label":"Payable d","value":"322.8"},{"label":"OPM %","value":"45.0%"},{"label":"Promoter %","value":"74.0%"}],"s":"IMAGICAA","sec":"Entertainment","sec2":"Consumer Services","sections":{"bull_bear":[{"body":"Not disclosed","src":"concall","title":"Capital allocation"},{"body":"Regulatory risks, competition from other entertainment companies","src":"concall","title":"Risks & watch-items"},{"body":"n/a (non-concall source)","src":"concall","title":"Management quality / tone"},{"body":"Imagicaa World has a strong brand presence in India, with a focus on providing unique entertainment experiences","src":"concall","title":"Non-obvious takeaways"}],"business":[{"body":"Theme Parks, Amusement Parks","src":"concall","title":"Segment / subsidiary detail"},{"body":"| — | — | — | — |","src":"concall","title":"Challenges → beneficiaries & losers"},{"body":"- Imagicaaworld is one of the largest amusement & theme park players in India by revenue and number of parks, operating 8 parks across 5 locations in Western India spanning ~220 acres, backed by the diversified Malpani Group (FMCG, real estate, renewable energy, hospitality, education).\n- Strong regional dominance in the western belt is a key moat: Khopoli-Lonavala parks address the MMR+Pune catchment of ~34mn population, Surat and upcoming Sabarmati/Ahmedabad parks address ~15mn, and Indore addresses the Indore-Ujjain-Dewas catchment of ~8mn.\n- Industry entry barriers favor incumbents — capital-intensive set-up (large parks need 30-50 acres of land), land acquisition hurdles, and the executional/operational expertise required given long break-even periods — while most competitors lack differentiated ride/experience offerings.\n- 150+ rides and attractions spanning theme park, amusement park, water park, devotional park and 5-star hotel formats, with international rides sourced from Switzerland, US, Canada, Turkey and Italy, support best-in-class positioning and repeat visitation.","src":"deck","title":"Positioning (investor deck)"},{"body":"- [Awards] Recognized with a Guinness World Record for Most People Unboxing Simultaneously (1,100+ underprivileged children), TripAdvisor Travellers' Choice Award (2020), and FICCI Travel & Tourism Excellence Award (2019).\n- [Leadership] Promoter family (Rajesh, Manish, Jai Malpani) brings 20+ years of park-business experience, supported by a professional management team including a CEO with 30+ years in retail/entertainment (ex-Reliance Retail, Shoppers' Stop) and a CFO with 22+ years in project finance/treasury.","src":"deck","title":"Notable from the deck"}],"latest_quarter":[{"body":"India Ratings & Research, IND A/Stable/IND A1, Affirmed, March 16, 2026","src":"concall","title":"Financial scorecard / credit view"},{"body":"Not disclosed","src":"concall","title":"Margins & cost dynamics"}],"outlook":[{"body":"Stable outlook, with a focus on expanding operations and improving financial performance","src":"concall","title":"Guidance / outlook"},{"body":"Not disclosed","src":"concall","title":"Order book & pipeline"},{"body":"Expansion into new markets, introduction of new attractions","src":"concall","title":"Growth verticals / optionality"}]},"sources":["FY26 concall summary","structured quarterly financials","investor presentation (06-02-2026)","Walk-the-Talk commitments ledger","credit-rating action (India Ratings & Research (Ind-Ra) 16-03-2026)"],"thesis":"Imagicaa World is a leading entertainment company in India, operating theme parks and amusement parks, with a strong focus on tourism and leisure activities.","track":{"expired_n":0,"open":[{"category":"capex_project","horizon":"Mar 2024","item":"Acquire the upcoming Indore water park assets from Malpani Parks Indore for Rs 140 crore, with the transaction expected to complete in March 2024.","promised":"140 INR cr","quarter":"Q3FY24"},{"category":"target","horizon":"at launch","item":"Target ARPU of Rs 900-1000 at the Indore park to begin with.","promised":"900-1000 INR","quarter":"Q3FY24"},{"category":"capex_project","horizon":"Q1FY25","item":"Indore water park (20 water rides, three restaurants) to commence operations in Q1 FY25.","promised":"Q1FY25 date","quarter":"Q3FY24"},{"category":"capex_project","horizon":"by Apr/May 2024","item":"Total Indore park capex will not cross Rs 140 crore, with no immediate additional capex required for Surat or Lonavala parks (all park capex to be completed by April/May 2024).","promised":"140 INR cr","quarter":"Q3FY24"},{"category":"capital_allocation","horizon":"post-acquisition","item":"Combined post-acquisition debt to be in the range of Rs 350-400 crore, with the remainder funded from internal accruals.","promised":"350-400 INR cr","quarter":"Q3FY24"},{"category":"guidance","horizon":"FY25","item":"Post-acquisition footfall and EBITDA will double and revenue will increase by 1.5X.","promised":"2x footfall/EBITDA, 1.5x revenue x","quarter":"Q3FY24"},{"category":"target","horizon":"FY25","item":"Post-acquisition the combined entity will have five locations with eight parks, 2.8 million footfall, over Rs 400 crore revenue and more than Rs 175 crore EBITDA.","promised":"400+ revenue / 175+ EBITDA INR cr","quarter":"Q3FY24"},{"category":"guidance","horizon":"FY26","item":"Indore park expected to add around 3.5 lakh footfall in its first full year of operations (FY26).","promised":"3.5 lakh footfall","quarter":"Q3FY24"},{"category":"operational_metric","horizon":"next 2 years","item":"Maintain overall advertising, marketing and sales distribution cost below 10% of sales over the next two years.","promised":"sub-10 %","quarter":"Q3FY24"},{"category":"capex_project","horizon":"over 30 months from Apr 2024","item":"Acquire four operational Wet N Joy parks (two water parks, one amusement park, one Sai Teerth devotional park) from Giriraj Enterprises on a slump-sale basis for Rs 630 crore payable over 30 months beginning April 2024.","promised":"630 INR cr","quarter":"Q3FY24"},{"category":"guidance","horizon":"over 2-2.5 years","item":"Indore park to begin at roughly 40%-45% EBITDA margin, improving northwards over 2 to 2.5 years.","promised":"40-45 %","quarter":"Q3FY24"},{"category":"capital_allocation","horizon":"3-4 years","item":"Indore park carries a 30% capital subsidy which Imagicaa will avail, reducing the Rs 140 crore fixed-asset cost by ~30% over the next 3 to 4 years.","promised":"30 %","quarter":"Q3FY24"},{"category":"strategic_priority","horizon":"ongoing / next 4-5 years","item":"Expand presence across all Tier-I and premium Tier-II cities in India, evaluating options with state governments in NCR, Gujarat, Goa, Punjab, Tamil Nadu and Uttarakhand (MoU signed).","promised":"","quarter":"Q3FY24"},{"category":"strategic_priority","horizon":"ongoing","item":"All future park expansions and acquisitions will be done under the listed entity only, consolidating all group park businesses into one entity.","promised":"","quarter":"Q3FY24"},{"category":"operational_metric","horizon":"ongoing post-acquisition","item":"Expect cost synergies of roughly 10%-15% from a common senior team and up to ~15% procurement savings across the combined parks.","promised":"10-15 %","quarter":"Q3FY24"},{"category":"target","horizon":"years to come","item":"Combined EBITDA margin (~44%-45% on a simple add-up) expected to inch closer to 50% in the years to come.","promised":"~50 %","quarter":"Q3FY24"},{"category":"target","horizon":"ongoing","item":"Target IRRs of 18%-