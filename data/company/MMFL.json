06",495.15],["2026-07-07",494.6],["2026-07-08",500.1],["2026-07-09",510.1],["2026-07-10",523.4]],"qtr":"FY26","ratios":[{"label":"ROE %","value":"14.5%"},{"label":"ROCE %","value":"11.9%"},{"label":"D/E","value":"1.3x"},{"label":"Int cover","value":"3.8x"},{"label":"Receivable d","value":"75.2"},{"label":"Inventory d","value":"82.2"},{"label":"Payable d","value":"91.8"},{"label":"OPM %","value":"20.9%"},{"label":"Promoter %","value":"56.3%"}],"s":"MMFL","sec":"Auto Components","sec2":"Automobile and Auto Components","sections":{"bull_bear":[{"body":"Focus on reducing debt and improving return on capital employed","src":"concall","title":"Capital allocation"},{"body":"Dependence on cyclical auto industry, moderate capital structure, client concentration risk, exposure to raw material price volatility","src":"concall","title":"Risks & watch-items"},{"body":"n/a (non-concall source)","src":"concall","title":"Management quality / tone"},{"body":"The company's natural hedge from exports partly offsets the impact of raw material price volatility","src":"concall","title":"Non-obvious takeaways"},{"body":"- Board recommended an interim dividend of ₹4/- per share for FY26.","src":"deck","title":"Capital allocation policy (investor deck)"}],"business":[{"body":"Commercial Vehicles: 76% of revenue (FY25); Passenger Vehicles: 8% of revenue (FY25); Agri and Off-highway: 16% of revenue (FY25)","src":"concall","title":"Segment / subsidiary detail"},{"body":"| — | — | — | — |","src":"concall","title":"Challenges → beneficiaries & losers"},{"body":"- Operational stability maintained through proactive sourcing, improved efficiencies, and disciplined cost management despite geopolitical and trade uncertainties.\n- Demand visibility remains encouraging, supported by strengthening domestic market conditions and gradual improvement in export enquiries across select geographies.","src":"deck","title":"Positioning (investor deck)"}],"latest_quarter":[{"body":"Revenue: ₹1,525 crore (FY25); EBITDA: ₹296 crore (FY25); PAT: ₹122 crore (FY25); Net Debt: ₹1,033 crore (FY25); Credit Rating: CARE A; Stable; Outlook: Stable; Rationale: Established track record, healthy business risk profile, and stable scale, but constrained by moderate capital structure and high dependence on the cyclical automotive industry","src":"concall","title":"Financial scorecard / credit view"},{"body":"PBILDT margin: 19.41% (FY25); Interest coverage: 4.95x (FY25); Total debt to gross cash accruals: 5.30x (FY25)","src":"concall","title":"Margins & cost dynamics"}],"outlook":[{"body":"Outlook: Stable; Strategy: Focus on expanding forging and machining capabilities, improving operating margins, and reducing customer concentration risk","src":"concall","title":"Guidance / outlook"},{"body":"Not available","src":"concall","title":"Order book & pipeline"},{"body":"Increasing demand for heavier forgings in machined condition, expansion into new markets, and potential for growth in the electric vehicles segment","src":"concall","title":"Growth verticals / optionality"}]},"sources":["FY26 concall summary","structured quarterly financials","investor presentation (28-05-2026)","Walk-the-Talk commitments ledger"],"thesis":"M M Forgings Limited is a leading manufacturer of steel forgings with a strong presence in the domestic and export markets, but faces challenges due to its dependence on the cyclical auto industry and moderate capital structure.","track":{"expired_n":12,"open":[{"category":"risk_flag","horizon":"FY26","item":"Domestic addressable market shrinking as multi-axle vehicles give way to tractor-trailers (fewer front axles); domestic CV static, ~+/-2%.","promised":"2 %","quarter":"Q2FY26"},{"category":"risk_flag","horizon":"by Mar 2026","item":"US 50% tariff borne by customers (CIF contracts); expected absorbed until ~March, then resourcing/renegotiation likely; margins could pressure if sustained.","promised":"50 %","quarter":"Q2FY26"},{"category":"capital_allocation","horizon":"FY26","item":"Net debt to come down ~INR 50-75 Crores via inventory compression; scope for at least INR 50 Cr inventory reduction.","promised":"50-75 INR cr","quarter":"Q2FY26"},{"category":"capital_allocation","horizon":"FY26","item":"Converting rupee loans to forex to cut interest; H1 interest INR 39 Cr; targeting FY26 interest within INR 70 Cr, run-rate INR 50-60 Cr (saves ~INR 12 Cr/yr).","promised":"50-60 INR cr","quarter":"Q2FY26"},{"category":"guidance","horizon":"H2FY26","item":"H1 EBITDA 19% (17.5% operational) vs 21%; EBITDA/ton INR 38,000 vs 40,500; margins expected to only improve from these levels if sales have bottomed.","promised":"38000 INR/tonne","quarter":"Q2FY26"},{"category":"guidance","horizon":"H2FY26","item":"H2 FY26 revenue expected ~INR 750-800 Crores, taking full-year close to previous year's level (give or take a few percent).","promised":"750-800 INR cr","quarter":"Q2FY26"},{"category":"strategic_priority","horizon":"FY26","item":"Plan to add wind/solar green power (from ~3 cr to up to 10 cr units) to insulate against 5%/yr TN power hikes; ~150 bps EBITDA benefit, likely from next year.","promised":"150 bps","quarter":"Q4FY24"},{"category":"guidance","horizon":"Q1FY27","item":"US Class VIII truck market seen as bottom (Q2 worst); customer restocking from November, reasonable levels by June 2026.","promised":"","quarter":"Q2FY26"},{"category":"capex_project","horizon":"Q2FY27","item":"World's largest 16,500 ton hot forging mechanical press to be commissioned by March-April 2026, adding ~INR 300 Crores turnover from Q2 FY27 at better (10-20% higher/kg) margins.","promised":"300 INR cr","quarter":"Q2FY26"},{"category":"target","horizon":"FY27","item":"Order book of ~INR 300 Crores revenue, of which ~INR 200 Crores expected to realize in FY27.","promised":"200 INR cr","quarter":"Q2FY26"},{"category":"target","horizon":"FY26-FY27","item":"Abhinava Rizel acquired first customer (~INR 20-30 Cr annual potential); sample parts to be delivered end-Nov 2025, then production; also commercializing controllers.","promised":"20-30 INR cr","quarter":"Q2FY26"},{"category":"guidance","horizon":"12-18 months","item":"Sales expected to grow by at least INR 300 Crores in next 12-18 months; decline reversing to growth from FY27 onwards.","promised":"300 INR cr","quarter":"Q2FY26"},{"category":"capex_project","horizon":"FY27","item":"FY26 capex ~INR 170 Cr (INR 100 Cr H1, ~INR 70 Cr H2); FY27 capex ~INR 100-120 Cr; ~INR 70 Cr investment remaining at fag end of expansion cycle.","promised":"100-120 INR cr","quarter":"Q2FY26"},{"category":"capital_allocation","horizon":"next 2 years","item":"Net debt ~INR 850-855 Crores declared as peak debt; no more borrowing intended, hold at these levels; no significant reduction next 2 years (store cash / cut working capital instead).","promised":"850 INR cr","quarter":"Q2FY26"},{"category":"target","horizon":"FY27-FY28","item":"New export customer acquisitions expected to add at least INR 100 Crores of export sales in FY27 and FY28.","promised":"100 INR cr","quarter":"Q4FY25"},{"category":"target","horizon":"7-10 years","item":"Abhinava Rizel/EV powertrain (incl controllers) long-term revenue of Rs.1,000-2,000 Crores over 7-10 year horizon.","promised":"1000-2000 INR cr","quarter":"Q1FY24"},{"category":"strategic_priority","horizon":"near-term","item":"Wholly-owned subsidiary DVS Industries to be merged into MM Forgings; NCLT proceedings on, merger expected any time.","promised":"","quarter":"Q2FY26"},{"category":"capital_allocation","horizon":"outlier","item":"Possible equity infusion flagged as an outlier option to strengthen balance sheet given peak debt.","promised":"","quarter":"Q2FY26"},{"category":"target","horizon":"medium-term","item":"Existing ~INR 1,000 Cr / 5-yr capex to add ~INR 500-700 Crores to current ~INR 1,500 Cr turnover, crossing INR 2,000 Crores; asset turn ~1.2x max.","promised":"500-700 INR cr","quarter":"Q2FY26"},{"category":"risk_flag","horizon":"ongoing","item":