rse global trade conditions, may affect vehicle production, customer demand and consequently the Company's revenues.","src":"drhp","as_of":"2023-07-05"},"strategy":{"title":"Strategies (RHP)","body":"- Actively exploring diversification into Electric Vehicles (EVs), the aftermarket, exports, and the defence sector.\n- Institutionalizing sound commercial processes and building world-class commercial capabilities across marketing and sales teams to strengthen its commercial backbone.\n- Continuing to develop new products and services through an innovative approach to execute growth opportunities.","src":"drhp","as_of":"2023-07-05"}},"scorecard":{"symbol":"URAVIDEF","fin_source":"shadow ledger (per-field legacy fallback)","fy_asof":"2026-03-31","opm_basis":"TTM 4q","opm_ttm":"4.65","roe":"4.208456243854474","roce":"3.78","bq_a":"0","sales_cagr_3y":"4.430692977247541","eps_cagr_3y":"7.530885242410923","bq_b":"2","debt_equity":"0.4643067846607669","interest_cover":"1.6935483870967742","bq_c":"6","cfo_pat_3y":"-0.2629666430092264","wc_basis":"WC/sales trend","bq_d":"5","share_cagr_3y":"1.1588412957596939","bq_e":"4","shp_asof":"2026-06-30","promoter_pct":"45.01","promoter_prev":"58.04","pledge_basis":"pledge not in snapshot -> 0 penalty (hook)","piotroski_basis":"needs 2 FYs of BS_* -> 0 (real from FY27)","bq_f":"-3","g_integrity":"5","g_execution":"0","g_capalloc":"0","g_basis":"defaults (no WTT/ledger coverage)","bq_g":"5","bq_total":"19","bq_gate":"False","stage2":"False","sector_on":"False","market_on":"True","rs_rank":"","per_a":"5","pe_ttm":"52.654708520179376","pe_basis":"TTM trailing (spec band written for forward P/E)","per_b":"0","earn_accel":"ACCEL","rev_accel":"NEUTRAL","per_c":"25","per_d":"6","per_e":"0","per_total":"36","per_gate":"False","advt_rs":"","full_position_eligible":"False","verdict":"OBSERVE","notes":""},"concallIntel":{},"segments":[],"themes":[],"ipo":{"summary":{"Price Range":"100","Issue Price":"265","Issue Start Date":"2018-03-16","Issue End