ompetition\" — a driver of both capital availability and competitive intensity|\"the …","objects":null,"oem":"","one_liner":"Go Digit General Insurance is an Indian non-life insurer writing a multi-line book led by Motor, with a roughly 3.4% share of industry gross written premium in FY2025-26.","peer_panel":{"asof":"2026-08-14","industry":"Insurance","peers":[{"ebitda_margin":7.5,"fy":"FY26","growth_basis":"YoY","mcap":74646,"name":"PB Fintech Limited (Policybazaar)","pat":670.1,"pat_growth":89.8,"pe":111.4,"rev":6794.0,"rev_growth":50.3,"s":"POLICYBZR","source":"drhp","why":"named in DRHP"},{"ebitda_margin":13.8,"fy":"FY26","growth_basis":"","mcap":93690,"name":"ICICI LOMBARD GIC LIMITED","pat":2771.9,"pat_growth":null,"pe":33.8,"rev":26994.4,"rev_growth":null,"s":"ICICIGI","source":"product","why":"shares 2026/accident/across/active"},{"ebitda_margin":2.1,"fy":"FY26","growth_basis":"7y CAGR","mcap":88979,"name":"ICICI PRU LIFE INS CO LTD","pat":1607.9,"pat_growth":5.0,"pe":55.3,"rev":63356.8,"rev_growth":11.0,"s":"ICICIPRULI","source":"product","why":"shares 2026/across/against/business"},{"ebitda_margin":0.4,"fy":"FY26","growth_basis":"7y CAGR","mcap":58721,"name":"MAX FINANCIAL SERV LTD","pat":105.6,"pat_growth":-12.2,"pe":556.1,"rev":47674.1,"rev_growth":13.6,"s":"MFSL","source":"product","why":"shares 2026/across/business/channel"},{"ebitda_margin":4.2,"fy":"FY26","growth_basis":"","mcap":26968,"name":"STAR HEALTH & AL INS CO L","pat":557.0,"pat_growth":null,"pe":48.4,"rev":17825.0,"rev_growth":null,"s":"STARHEALTH","source":"product","why":"shares 2026/active/agents/business"},{"ebitda_margin":0.9,"fy":"FY26","growth_basis":"7y CAGR","mcap":22845,"name":"THE NEW INDIA ASSU CO LTD","pat":1416.8,"pat_growth":12.7,"pe":16.1,"rev":49757.6,"rev_growth":12.7,"s":"NIACL","source":"product","why":"shares about/against/been/being"},{"ebitda_margin":1.9,"fy":"FY26","growth_basis":"","mcap":13241,"name":"NIVA BUPA HEALTH INS CO L","pat":130.8,"pat_growth":null,"pe":101