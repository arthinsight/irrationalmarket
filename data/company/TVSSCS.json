{"drhp":{"anchor_allotment":null,"as_of":"","board":[{"designation":"Director (retires by rotation at the 22nd AGM, eligible for re-appointment)","independent":false,"name":"R Dinesh"},{"designation":"Director (retires by rotation at the 22nd AGM, eligible for re-appointment)","independent":false,"name":"Shobhana Ramachandhran"},{"designation":"Managing Director (resigned as Director and stepped down as Managing Director with effect from June 30, 2026)","independent":false,"name":"Ravi Viswanathan"},{"designation":"Additional Director and Managing Director (appointed with effect from July 1, 2026 for five years to June 30, 2031, subject to shareholder approval; DIN 06624266)","independent":false,"name":"Vikas Chadha"}],"business":"TVS Supply Chain Solutions is an India-based multinational that pioneered the supply chain solutions market in India, evolving from automotive logistics into a diversified, global, asset-light and tech-led provider. It designs, orchestrates and optimises supply chains across the entire value chain from sourcing to consumption for leading customers across industrial, technology, consumer and other high-growth sectors. Operations are organised into two segments: Integrated Supply Chain Solutions (ISCS) and Global Forwarding Solutions (GFS).","certs":"","co":"TVS SUPPLY CHAIN SOL L","depth":"deep","end_markets":"Industrial|Technology|Consumer|Fast-Moving Consumer Goods (FMCG)|Fast-Moving Consumer Durables (FMCD)|Aerospace and Defence|Automotive / aftermarket|India|United Kingdom / Europe|North America|Asia-Pacific (Singapore, Australia, Thailand)","expansion":"TVS Supply Chain Solutions describes itself as a tech-led and asset-light supply chain solutions provider, so the FY26 report's routed sections disclose no plant/capacity capex projects with rupee outlays or commissioning timelines; expansion is organic and contract-led rather than fixed-asset-led. During FY26 the company re-organised its segment structure, unifying the erstwhile ISCS and Integrated Facility Management (IFM) capabilities into a single ISCS segment to deliver bundled, end-to-end services tailored to client needs, while Global Forwarding Solution (GFS) continues to house …","grades":{"rel":0,"s":"","wm90":null},"industry":"Transport Services","isin":"INE395N01027","kpi":null,"listed_on":"2023-08-23","litigation":{"as_of":"","material":false,"note":"The Auditors' Report and Secretarial Audit Report contain no qualification, disclaimer, reservation or adverse remarks; contingent liabilities disclosed per accounting policy."},"mdna":"","objects":null,"oem":"","one_liner":"A tech-led, asset-light, integrated global supply chain solutions provider rooted in the TVS heritage, orchestrating end-to-end supply chains across industrial, technology and consumer sectors.","peer_panel":{"asof":"2026-08-14","industry":"Transport Services","peers":[{"ebitda_margin":6.1,"fy":"FY26","growth_basis":"YoY","mcap":31633,"name":"Delhivery Limited","pat":152.5,"pat_growth":-5.9,"pe":207.4,"rev":10508.3,"rev_growth":23.6,"s":"DELHIVERY","source":"drhp","why":"named in DRHP"},{"ebitda_margin":15.5,"fy":"FY26","growth_basis":"7y CAGR","mcap":12823,"name":"Blue Dart Express Limited","pat":247.4,"pat_growth":15.6,"pe":51.8,"rev":6140.9,"rev_growth":9.9,"s":"BLUEDART","source":"drhp","why":"named in DRHP"},{"ebitda_margin":17.3,"fy":"FY26","growth_basis":"2y CAGR","mcap":1120,"name":"Unicommerce eSolutions Limited","pat":20.5,"pat_growth":24.9,"pe":54.6,"rev":204.3,"rev_growth":40.5,"s":"UNIECOM","source":"drhp","why":"named in DRHP"},{"ebitda_margin":5.4,"fy":"FY26","growth_basis":"7y CAGR","mcap":3891,"name":"MAHINDRA LOGISTIC LIMITED","pat":10.6,"pat_growth":-25.9,"pe":367.1,"rev":6999.3,"rev_growth":8.9,"s":"MAHLOG","source":"product","why":"shares chain/delivery/forwarding/freight"},{"ebitda_margin":11.1,"fy":"FY26","growth_basis":"7y CAGR","mcap":525,"name":"GLOBE INTL CARRIERS LTD","pat":11.6,"pat_growth":32.6,"pe":45.3,"rev":174.9,"rev_growth":6.0,"s":"